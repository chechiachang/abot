issuer: http://localhost:5556/dex
storage:
  type: memory
web:
  http: 0.0.0.0:5556
oauth2:
  responseTypes: [code]
  skipApprovalScreen: true
staticClients:
  - id: vault
    name: Vault demo
    secretEnv: DEX_VAULT_CLIENT_SECRET
    redirectURIs:
      - http://localhost:8250/oidc/callback
      - http://localhost:8200/ui/vault/auth/oidc/oidc/callback
  - id: agentgateway-ui
    name: Agentgateway UI
    secretEnv: DEX_AGENTGATEWAY_CLIENT_SECRET
    redirectURIs:
      - http://localhost:4000/oauth/callback
connectors:
  - type: github
    id: github
    name: GitHub
    config:
      clientID: $GITHUB_OAUTH_CLIENT_ID
      clientSecret: $GITHUB_OAUTH_CLIENT_SECRET
      redirectURI: http://localhost:5556/dex/callback
      orgs:
        - name: $GITHUB_ORG
