# Run make setup to generate local secrets. Never use dev Vault in production.
VAULT_DEV_ROOT_TOKEN_ID=

# Organization membership AND this username are required to mint gateway JWTs.
GITHUB_ORG=your-github-org
GITHUB_USER=your-github-username

# GitHub OAuth App callback: http://localhost:5556/dex/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Shared by Dex and Vault; local demo only.
DEX_VAULT_CLIENT_SECRET=
DEX_AGENTGATEWAY_CLIENT_SECRET=
# Local demo UI session key: 64 hexadecimal characters.
AGENTGATEWAY_SESSION_KEY=

# HTTPS resource URL without a trailing slash or path; shared by both APIs.
AZURE_OPENAI_BASE_URL=https://national-team.openai.azure.com
# Needed for chat completions and SystemOne, not for GET /v1/models.
AZURE_OPENAI_API_KEY=

# Independent OIDC cookie encryption key; generated by make setup.
OIDC_COOKIE_SECRET=
